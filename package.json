{
  "name": "loreverse-app",
  "version": "1.0.0",
  "private": true,
  "description": "LOREVERSE Android and iOS app built with Capacitor",
  "scripts": {
    "prepare:web": "node scripts/prepare-web.mjs",
    "build": "npm run prepare:web",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "typescript": "^5.9.3",
    "@playwright/test": "^1.56.1"
  }
}
